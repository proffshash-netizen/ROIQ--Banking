# ROIQ Banking System - Environment Configuration Example

# Backend Application Settings
APP_NAME="ROIQ AI Backend"
APP_VERSION="0.1.0"
DEBUG="false"
PORT=8000

# Security & Authentication
JWT_SECRET_KEY="replace-with-secure-32-byte-secret-key-for-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="480"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL="postgresql+psycopg://roiq_user:roiq_secure_password@localhost:5432/roiq_banking_db"
# Local development fallback: DATABASE_URL="sqlite:///./roiq_banking.db"

# Groq LLM Inference Integration
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"

# External Financial Data Providers (Optional / Graceful Fallback)
FRED_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Frontend Configuration (for client .env if needed)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
